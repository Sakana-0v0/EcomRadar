# EcomRadar 环境变量模板
# ===================================================
# LLM API 配置
# ===================================================
LLM_API_KEY=your_api_key_here
LLM_MODEL_NAME=MiniMax-M3
LLM_BASE_URL=https://api.minimax.cn/v1

# ===================================================
# 凭证加密 Master Key (Phase 6/7)
# ===================================================
# 生成方法: openssl rand -base64 32
# 必须妥善保管, 一旦丢失所有已加密凭证不可恢复
ECOMRADAR_CREDENTIAL_KEY=change-me-to-a-random-32-byte-base64-string

# ===================================================
# Notion 集成 (Phase 7 - 可选)
# ===================================================
# 创建: https://www.notion.so/profile/integrations
# 能力: Read content / Update content / Insert content
# ⚠️ 不要提交真实 key 到 git!
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=

# ===================================================
# 飞书集成 (Phase 7 - 可选)
# ===================================================
# 创建: https://open.feishu.cn/app
# 权限: docs:document:create / drive:file:upload
# ⚠️ 不要提交真实 key 到 git!
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_FOLDER_TOKEN=

# Embedding API 配置
EMBED_API_KEY=your_embed_api_key
EMBED_MODEL_NAME=qwen3.7-text-embedding
EMBED_BASE_URL=https://ws-fdik2f21nxb2i3yf.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# ===================================================
# Qdrant 向量数据库配置
# ===================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_VECTOR_SIZE=1024
QDRANT_KB_COLLECTION=knowledge_base
QDRANT_CACHE_COLLECTION=task_cache

# ===================================================
# Scraper 反爬合规配置
# ===================================================
SCRAPER_RATE_LIMIT=1.0
SCRAPER_RETRY_TIMES=3
SCRAPER_RETRY_BACKOFF=2.0
SCRAPER_MAX_CONCURRENCY=5
SCRAPER_REQUEST_TIMEOUT=5.0
JINA_READER_URL=https://r.jina.ai
ROBOTS_RESPECT=true
ROBOTS_CACHE_TTL=60.0

# ===================================================
# FastAPI 配置
# ===================================================
API_HOST=0.0.0.0
API_PORT=8000

# ===================================================
# 日志配置
# ===================================================
LOG_LEVEL=INFO
